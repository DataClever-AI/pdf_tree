      "section": {
        "section_id": "sec_0176",
        "title": "10.6.3 Waveform Confirmation",
        "hierarchy_level": 3,
        "hierarchy_path": "/Monitoring with the HemoSphere Pressure Cable/10.6 Zero & Waveform Screen/10.6.3 Waveform Confirmation",
        "page_start": 144,
        "page_end": 144,
        "parent_section_id": "sec_0173",
        "child_sections": [],
        "node_count": 7,
        "confidence": 1.0,
        "structural_source": "toc",
        "flagged_for_review": false,
        "verification_score": 100.0,
        "verification_reason": "",
        "numbering_scheme": "arabic",
        "offset_applied": 0,
        "semantic_order_start": 2203,
        "semantic_order_end": 2209,
        "semantic_nodes": [
          {
            "node_id": "#/texts/2203",
            "canonical_text": "10.6.3 Waveform Confirmation",
            "semantic_order": 2203,
            "node_type": "heading",
            "page_no": 144,
            "bbox": {
              "x0": 104.9280014038086,
              "y0": 712.2479858398438,
              "x1": 283.6055908203125,
              "y1": 703.2479858398438
            }
          },
          {
            "node_id": "#/texts/2204",
            "canonical_text": "The Zero & Waveform screen displays the arterial pressure waveform. Use this screen or the continuous, real-time arterial (ART) waveform display (see link to Graphical trend subsection) to assess the quality of the arterial waveform in response to \"Fault: CO – Check Arterial Waveform\". This fault is generated when the arterial pressure signal quality has been poor for too long.",
            "semantic_order": 2204,
            "node_type": "paragraph",
            "page_no": 144,
            "bbox": {
              "x0": 103.88117980957031,
              "y0": 690.2648315429688,
              "x1": 504.0538330078125,
              "y1": 628.1981811523438
            }
          },
          {
            "node_id": "#/texts/2205",
            "canonical_text": "The vertical axis is auto-scaled to the Average BP value ± 50 mmHg.",
            "semantic_order": 2205,
            "node_type": "paragraph",
            "page_no": 144,
            "bbox": {
              "x0": 103.96902465820312,
              "y0": 619.2582397460938,
              "x1": 396.52789306640625,
              "y1": 609.1786499023438
            }
          },
          {
            "node_id": "#/texts/2206",
            "canonical_text": "Monitoring PAP in Swan-Ganz Module Mode. The Zero & Waveform is also utilized to monitor the pulmonary artery pressure (PAP) when using the HemoSphere Swan-Ganz module in combination with the pressure cable. Although PAP is not available as a key parameter, the waveform can be viewed on this screen.",
            "semantic_order": 2206,
            "node_type": "paragraph",
            "page_no": 144,
            "bbox": {
              "x0": 104.11286926269531,
              "y0": 593.2455444335938,
              "x1": 558.442138671875,
              "y1": 557.2190551757812
            }
          },
          {
            "node_id": "#/texts/2207",
            "canonical_text": "WARNING Do not use the HemoSphere advanced monitoring platform as a pulse rate or blood pressure monitor.",
            "semantic_order": 2207,
            "node_type": "paragraph",
            "page_no": 144,
            "bbox": {

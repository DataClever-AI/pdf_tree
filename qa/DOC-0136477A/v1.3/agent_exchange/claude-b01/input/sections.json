            }
          },
          {
            "node_id": "#/texts/3170",
            "canonical_text": "Declaration of Compliance – EU Directive 2003/95/EC; Reduction of Hazardous Substances (RoHS)",
            "semantic_order": 3265,
            "node_type": "paragraph",
            "page_no": 232,
            "bbox": {
              "x0": 142.14077758789062,
              "y0": 572.662353515625,
              "x1": 545.9983520507812,
              "y1": 548.3613891601562
            }
          },
          {
            "node_id": "#/texts/3171",
            "canonical_text": "This device is a 2.4 GHz wideband transmission system (transceiver), intended for use in all EU member states and EFTA countries, except in France and Italy where restrictive use applies.",
            "semantic_order": 3266,
            "node_type": "paragraph",
            "page_no": 232,
            "bbox": {
              "x0": 104.02920532226562,
              "y0": 540.27685546875,
              "x1": 552.0077514648438,
              "y1": 517.2210083007812
            }
          },
          {
            "node_id": "#/texts/3172",
            "canonical_text": "In Italy the end-user should apply for a license at the national spectrum authorities in order to obtain authorization to use the device for setting up outdoor radio links and/or for supplying public access to telecommunications and/or network services.",
            "semantic_order": 3267,
            "node_type": "paragraph",
            "page_no": 232,
            "bbox": {
              "x0": 104.2707748413086,
              "y0": 508.2371826171875,
              "x1": 543.35546875,
              "y1": 473.55029296875
            }
          },
          {
            "node_id": "#/texts/3173",
            "canonical_text": "This device may not be used for setting up outdoor radio links in France and in some areas the RF output power may be limited to 10 mW EIRP in the frequency range of 2454 – 2483.5 MHz. For detailed information the end-user should contact the national spectrum authority in France.",
            "semantic_order": 3268,
            "node_type": "paragraph",
            "page_no": 232,
            "bbox": {
              "x0": 104.02921295166016,
              "y0": 463.23785400390625,
              "x1": 556.6434326171875,
              "y1": 427.2223815917969
            }
          },
          {
            "node_id": "#/texts/3174",
            "canonical_text": "Hereby, Edwards Lifesciences, declares that this monitor is in compliance with the essential requirements and other relevant provisions of Directive 1999/5/EC.",

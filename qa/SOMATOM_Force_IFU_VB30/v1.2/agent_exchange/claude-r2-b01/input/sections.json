              "y1": 805.7061767578125
            }
          },
          {
            "node_id": "#/texts/87",
            "canonical_text": "WARNING",
            "semantic_order": 85,
            "node_type": "heading",
            "page_no": 12,
            "bbox": {
              "x0": 231.74171447753906,
              "y0": 738.6861572265625,
              "x1": 278.8447265625,
              "y1": 731.0946655273438
            }
          },
          {
            "node_id": "#/texts/88",
            "canonical_text": "Not observing the Instructions for Use and the safety information of the medical device and the equipment!",
            "semantic_order": 86,
            "node_type": "paragraph",
            "page_no": 12,
            "bbox": {
              "x0": 209.77413940429688,
              "y0": 712.2687377929688,
              "x1": 523.8742065429688,
              "y1": 691.57470703125
            }
          },
          {
            "node_id": "#/texts/89",
            "canonical_text": "Injury to the patient or personnel, and damage to the equipment.",
            "semantic_order": 87,
            "node_type": "paragraph",
            "page_no": 12,
            "bbox": {
              "x0": 210.1071319580078,
              "y0": 682.3407592773438,
              "x1": 482.8340759277344,
              "y1": 673.4667358398438
            }
          },
          {
            "node_id": "#/texts/90",
            "canonical_text": "◆ Always observe the Instructions for Use of the particular units used. This includes the labels applied on the equipment as well as the Instructions for Use documents.",
            "semantic_order": 88,
            "node_type": "paragraph",
            "page_no": 12,
            "bbox": {
              "x0": 209.9494171142578,
              "y0": 664.2687377929688,
              "x1": 513.43408203125,
              "y1": 633.4197387695312
            }
          },
          {
            "node_id": "#/texts/91",
            "canonical_text": "◆ Always use this Instructions for Use document in conjunction with all Instructions for Use documents provided.",
            "semantic_order": 89,
            "node_type": "paragraph",
            "page_no": 12,
            "bbox": {
              "x0": 209.9494171142578,
              "y0": 625.2687377929688,
              "x1": 490.01617431640625,
              "y1": 604.57470703125
            }
          },
          {
            "node_id": "#/texts/92",
            "canonical_text": "◆ Follow the safety instructions and safety signs.",
            "semantic_order": 90,
            "node_type": "paragraph",
            "page_no": 12,
            "bbox": {
              "x0": 209.94943237304688,
              "y0": 598.2687377929688,
              "x1": 401.87017822265625,
              "y1": 589.4847412109375
            }
          },
          {
            "node_id": "#/texts/93",
            "canonical_text": "◆ For references purposes, store the Instructions for Use near your workplace.",
            "semantic_order": 91,
            "node_type": "paragraph",
            "page_no": 12,
            "bbox": {
              "x0": 209.94943237304688,
              "y0": 583.2687377929688,
              "x1": 516.2871704101562,
              "y1": 574.4847412109375
            }
          },
          {
            "node_id": "#/texts/94",
            "canonical_text": "Electronic Instructions for Use are provided on your CT system and on the workplace.",
            "semantic_order": 92,
            "node_type": "paragraph",
            "page_no": 12,
            "bbox": {
              "x0": 199.23484802246094,
              "y0": 552.9301147460938,
              "x1": 531.2178344726562,
              "y1": 544.1461181640625
            }
          }

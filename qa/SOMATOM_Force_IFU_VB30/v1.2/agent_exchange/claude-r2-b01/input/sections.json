        "semantic_nodes": [
          {
            "node_id": "#/texts/2622",
            "canonical_text": "3.5.4 Control box",
            "semantic_order": 2622,
            "node_type": "heading",
            "page_no": 124,
            "bbox": {
              "x0": 157.15394592285156,
              "y0": 633.9639892578125,
              "x1": 263.0228576660156,
              "y1": 624.927978515625
            }
          },
          {
            "node_id": "#/texts/2623",
            "canonical_text": "The control box can be used to control measurements and the patient table.",
            "semantic_order": 2623,
            "node_type": "paragraph",
            "page_no": 124,
            "bbox": {
              "x0": 198.54986572265625,
              "y0": 608.6072998046875,
              "x1": 496.9628601074219,
              "y1": 599.9132690429688
            }
          },
          {
            "node_id": "#/texts/2624",
            "canonical_text": "You can switch on or off the system.",
            "semantic_order": 2624,
            "node_type": "paragraph",
            "page_no": 124,
            "bbox": {
              "x0": 199.1171112060547,
              "y0": 589.4537353515625,
              "x1": 349.55181884765625,
              "y1": 580.6697387695312
            }
          },
          {
            "node_id": "#/texts/2625",
            "canonical_text": "You can start or stop a measurement.",
            "semantic_order": 2625,
            "node_type": "paragraph",
            "page_no": 124,
            "bbox": {
              "x0": 199.1170654296875,
              "y0": 569.8501586914062,
              "x1": 355.03277587890625,
              "y1": 561.6061401367188
            }
          },
          {
            "node_id": "#/texts/2626",
            "canonical_text": "You can move the patient table from outside of the examination room.",
            "semantic_order": 2626,
            "node_type": "paragraph",
            "page_no": 124,
            "bbox": {
              "x0": 199.11703491210938,
              "y0": 551.1466064453125,
              "x1": 485.874755859375,
              "y1": 542.4525756835938
            }
          },
          {
            "node_id": "#/texts/2627",
            "canonical_text": "You can communicate with the patient from outside of the examination room.",
            "semantic_order": 2627,
            "node_type": "paragraph",
            "page_no": 124,
            "bbox": {
              "x0": 199.11700439453125,
              "y0": 531.9930419921875,
              "x1": 515.8447265625,
              "y1": 523.2990112304688
            }
          },
          {
            "node_id": "#/texts/2628",
            "canonical_text": "It is within the responsibility of the personnel to make sure that no conflictive table movements or software actions are performed when the control box, the gantry operator panels, or the panel of the i-Control are in use.",
            "semantic_order": 2628,
            "node_type": "paragraph",
            "page_no": 124,
            "bbox": {
              "x0": 198.86463928222656,
              "y0": 504.7700500488281,
              "x1": 524.4486694335938,
              "y1": 472.0490417480469
            }
          },
          {
            "node_id": "#/texts/2629",
            "canonical_text": "A radiation warning lamp lights up and a warning signal sounds when X-radiation is being generated.",
            "semantic_order": 2629,
            "node_type": "paragraph",
            "page_no": 124,
            "bbox": {
              "x0": 198.54959106445312,
              "y0": 453.4930419921875,
              "x1": 527.5266723632812,
              "y1": 432.70904541015625
            }
          },
          {
            "node_id": "#/texts/2630",
            "canonical_text": "Force / Force Velo | Instructions for Use Print No. C2-058-C.621.01.01.02",
            "semantic_order": 2630,
            "node_type": "paragraph",
            "page_no": 124,
            "bbox": {

          {
            "node_id": "#/texts/86",
            "canonical_text": "2 Safety information",
            "semantic_order": 84,
            "node_type": "paragraph",
            "page_no": 12,
            "bbox": {
              "x0": 473.0229187011719,
              "y0": 814.5802001953125,

              "y0": 159.48117065429688,
              "x1": 184.15097045898438,
              "y1": 150.607177734375
            }
          },
          {
            "node_id": "#/texts/3961",
            "canonical_text": "You can use the table adjust keys on the gantry operator panel and the table up/down foot switch in parallel. ( Page 186 Moving the patient table using the foot switch)",
            "semantic_order": 3967,
            "node_type": "paragraph",
            "page_no": 183,
            "bbox": {
              "x0": 198.4203338623047,
              "y0": 159.4091796875,
              "x1": 535.263427734375,
              "y1": 138.6251678466797
            }
          },
          {
            "node_id": "#/texts/3962",
            "canonical_text": "Before you lower the patient table to a minimum height, you must completely retract the table top out of the gantry.",
            "semantic_order": 3968,
            "node_type": "paragraph",
            "page_no": 183,
            "bbox": {
              "x0": 198.71144104003906,
              "y0": 120.07128143310547,
              "x1": 529.42236328125,
              "y1": 99.28728485107422
            }
          },
          {
            "node_id": "#/texts/3963",
            "canonical_text": "Force / Force Velo | Instructions for Use Print No. C2-058-C.621.01.01.02",
            "semantic_order": 3969,

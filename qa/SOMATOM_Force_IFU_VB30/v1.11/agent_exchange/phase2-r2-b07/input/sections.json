          },
          {
            "node_id": "#/texts/3965",
            "canonical_text": "4 System operation",
            "semantic_order": 3971,
            "node_type": "paragraph",
            "page_no": 184,
            "bbox": {
              "x0": 477.6849365234375,
              "y0": 814.5802001953125,
              "x1": 563.3739013671875,
              "y1": 805.7061767578125
            }
          },
          {
            "node_id": "#/texts/3968",
            "canonical_text": "Caution, leg injuries",
            "semantic_order": 3972,
            "node_type": "heading",
            "page_no": 184,
            "bbox": {
              "x0": 198.87493896484375,
              "y0": 741.1793212890625,
              "x1": 282.02593994140625,
              "y1": 732.3052978515625
            }
          },
          {
            "node_id": "#/texts/3969",
            "canonical_text": "Increased risk that body parts can get pinched between table and floor. Take care when lowering the patient table to avoid injury to body parts. To avoid damaging the patient table, make sure no accessories (for example, a trolley or cart) are placed underneath the patient table while lowering it.",
            "semantic_order": 3973,
            "node_type": "paragraph",
            "page_no": 184,
            "bbox": {
              "x0": 215.55914306640625,
              "y0": 671.7778930664062,
              "x1": 522.59423828125,
              "y1": 626.9669189453125
            }
          },
          {
            "node_id": "#/texts/3970",
            "canonical_text": "WARNING",
            "semantic_order": 3974,
            "node_type": "heading",
            "page_no": 184,
            "bbox": {
              "x0": 231.74636840820312,
              "y0": 615.3297729492188,
              "x1": 278.849365234375,
              "y1": 607.73828125
            }
          },
          {
            "node_id": "#/texts/3971",
            "canonical_text": "Lowering the patient table!",
            "semantic_order": 3975,
            "node_type": "paragraph",
            "page_no": 184,
            "bbox": {
              "x0": 210.15682983398438,
              "y0": 588.912353515625,
              "x1": 315.8078308105469,
              "y1": 580.1283569335938
            }
          },
          {
            "node_id": "#/texts/3972",
            "canonical_text": "Body parts can get caught.",
            "semantic_order": 3976,
            "node_type": "heading",
            "page_no": 184,
            "bbox": {
              "x0": 210.11183166503906,
              "y0": 570.8223266601562,
              "x1": 320.2718200683594,
              "y1": 562.1103515625
            }
          },
          {
            "node_id": "#/texts/3973",
            "canonical_text": "◆ Make sure that the patients body parts are above the patient table.",
            "semantic_order": 3977,
            "node_type": "paragraph",
            "page_no": 184,
            "bbox": {
              "x0": 209.9451141357422,
              "y0": 552.912353515625,
              "x1": 481.11981201171875,
              "y1": 544.1283569335938
            }
          },
          {
            "node_id": "#/texts/3974",
            "canonical_text": "◆ Make sure that neither body parts of anybody nor any objects are below the patient table.",
            "semantic_order": 3978,
            "node_type": "paragraph",
            "page_no": 184,
            "bbox": {
              "x0": 209.94509887695312,
              "y0": 537.9122924804688,
              "x1": 516.9669189453125,
              "y1": 517.21826171875
            }
          },
          {
            "node_id": "#/texts/3975",
            "canonical_text": "◆ Press the Table up or Table down key and hold it down until the table is correctly positioned.",
            "semantic_order": 3979,
            "node_type": "paragraph",
            "page_no": 184,
            "bbox": {
              "x0": 199.0238494873047,
              "y0": 495.57373046875,
              "x1": 496.1585998535156,
              "y1": 474.78973388671875
            }
          },
          {
            "node_id": "#/texts/3976",
            "canonical_text": "The new vertical table top position (in mm) is displayed.",
            "semantic_order": 3980,
            "node_type": "paragraph",
            "page_no": 184,
            "bbox": {
              "x0": 212.72154235839844,
              "y0": 465.771728515625,

        "flagged_for_review": false,
        "verification_score": 100.0,
        "verification_reason": "",
        "numbering_scheme": "arabic",
        "offset_applied": 0,
        "semantic_order_start": 8181,
        "semantic_order_end": 8200,
        "semantic_nodes": [
          {
            "node_id": "#/texts/8107",
            "canonical_text": "Reconstructing with Cardio BestPhase",
            "semantic_order": 8181,
            "node_type": "heading",
            "page_no": 375,
            "bbox": {
              "x0": 71.52490234375,
              "y0": 314.0914001464844,
              "x1": 183.85391235351562,
              "y1": 295.1614074707031
            }
          },
          {
            "node_id": "#/texts/8122",
            "canonical_text": "Cardio BestPhase enables you to minimize the heart motion effects and to choose the most appropriate heart phase for postprocessing.",
            "semantic_order": 8182,
            "node_type": "paragraph",
            "page_no": 375,
            "bbox": {
              "x0": 198.9088897705078,
              "y0": 314.0194091796875,
              "x1": 533.600830078125,
              "y1": 293.23541259765625
            }
          },
          {
            "node_id": "#/texts/8123",
            "canonical_text": "The determined best phase represents optimal image quality in systolic phase (0-50% RR) or in diastolic phase (50-100% RR).",
            "semantic_order": 8183,
            "node_type": "paragraph",
            "page_no": 375,
            "bbox": {
              "x0": 198.54881286621094,
              "y0": 284.2174072265625,
              "x1": 537.9658203125,
              "y1": 263.3254089355469
            }
          },
          {
            "node_id": "#/texts/8124",
            "canonical_text": "Use Cardio BestPhase to reconstruct the images automatically irrespective of the heart motion.",
            "semantic_order": 8184,
            "node_type": "paragraph",
            "page_no": 375,
            "bbox": {
              "x0": 199.18240356445312,
              "y0": 254.0194091796875,
              "x1": 513.6064453125,
              "y1": 235.17041015625
            }
          },
          {
            "node_id": "#/texts/8125",
            "canonical_text": "As the system software defines the phase start for Cardio BestPhase reconstruction automatically, the Phase Start settings are dimmed. The Multiphase and Test series buttons are inactive. This phase is updated after the recon finished.",
            "semantic_order": 8185,
            "node_type": "paragraph",
            "page_no": 375,
            "bbox": {
              "x0": 198.55235290527344,
              "y0": 224.0194091796875,
              "x1": 532.443359375,
              "y1": 191.32540893554688
            }
          },
          {
            "node_id": "#/texts/8126",
            "canonical_text": "Force / Force Velo | Instructions for Use Print No. C2-058-C.621.01.01.02",
            "semantic_order": 8186,
            "node_type": "paragraph",
            "page_no": 375,
            "bbox": {
              "x0": 57.246402740478516,
              "y0": 37.01922607421875,
              "x1": 173.44039916992188,
              "y1": 23.020727157592773
            }
          },
          {
            "node_id": "#/texts/8127",
            "canonical_text": "SOMATOM | syngo CT VB30",
            "semantic_order": 8187,
            "node_type": "paragraph",
            "page_no": 375,
            "bbox": {
              "x0": 457.07623291015625,
              "y0": 36.71372604370117,
              "x1": 538.2807006835938,
              "y1": 30.610227584838867
            }
          },
          {
            "node_id": "#/texts/8128",
            "canonical_text": "375",
            "semantic_order": 8188,
            "node_type": "paragraph",
            "page_no": 375,
            "bbox": {
              "x0": 525.9732055664062,
              "y0": 28.16695785522461,
              "x1": 538.0782470703125,
              "y1": 22.736957550048828
            }
          },
          {
            "node_id": "#/texts/8129",
            "canonical_text": "7 Enhanced examination",
            "semantic_order": 8189,
            "node_type": "paragraph",
            "page_no": 376,
            "bbox": {
              "x0": 455.0859375,
              "y0": 814.5802001953125,
              "x1": 563.35595703125,
              "y1": 807.650146484375
            }
          },
          {
            "node_id": "#/texts/8132",
            "canonical_text": "◆ In the BestPhase list of the Trigger parameter card, select the appropriate option for the reconstruction phase:",
            "semantic_order": 8190,
            "node_type": "paragraph",
            "page_no": 376,
            "bbox": {
              "x0": 199.0281982421875,
              "y0": 741.1793212890625,
              "x1": 538.474609375,
              "y1": 720.4132690429688
            }
          },
          {
            "node_id": "#/texts/8133",
            "canonical_text": "· auto",
            "semantic_order": 8191,
            "node_type": "heading",
            "page_no": 376,
            "bbox": {
              "x0": 213.2912139892578,
              "y0": 709.062744140625,
              "x1": 241.13870239257812,
              "y1": 703.095703125
            }
          },
          {
            "node_id": "#/texts/8134",
            "canonical_text": "If you select auto, the system determines if a systole phase or a diastole phase is best suited for the reconstruction. Depending on the patient's heart rate, the system selects the best suited phase and sets the appropriate Unit .",
            "semantic_order": 8192,
            "node_type": "paragraph",
            "page_no": 376,
            "bbox": {
              "x0": 222.958740234375,
              "y0": 691.9537353515625,
              "x1": 532.0098266601562,
              "y1": 659.1697387695312
            }
          },
          {
            "node_id": "#/texts/8135",
            "canonical_text": "· BestSyst",
            "semantic_order": 8193,
            "node_type": "heading",
            "page_no": 376,
            "bbox": {
              "x0": 213.2912139892578,
              "y0": 648.4491577148438,
              "x1": 257.6626892089844,
              "y1": 639.9981689453125
            }
          },
          {
            "node_id": "#/texts/8136",
            "canonical_text": "If you select BestSyst, the system determines the best systole phase for the reconstruction. You have to select the appropriate Unit .",
            "semantic_order": 8194,
            "node_type": "paragraph",
            "page_no": 376,
            "bbox": {
              "x0": 223.27362060546875,
              "y0": 630.8001708984375,
              "x1": 518.74365234375,
              "y1": 610.1061401367188
            }
          },
          {
            "node_id": "#/texts/8137",
            "canonical_text": "· BestDiast",
            "semantic_order": 8195,
            "node_type": "heading",
            "page_no": 376,
            "bbox": {
              "x0": 213.29115295410156,
              "y0": 599.7186279296875,
              "x1": 261.49664306640625,
              "y1": 592.78857421875
            }
          },
          {
            "node_id": "#/texts/8138",
            "canonical_text": "If you select BestDiast, the system determines the best diastole phase for the reconstruction. You have to select the Unit .",
            "semantic_order": 8196,
            "node_type": "paragraph",
            "page_no": 376,
            "bbox": {
              "x0": 223.27352905273438,
              "y0": 581.7186279296875,
              "x1": 526.3036499023438,
              "y1": 562.78857421875
            }
          },
          {
            "node_id": "#/texts/8139",
            "canonical_text": "· manual",
            "semantic_order": 8197,
            "node_type": "heading",
            "page_no": 376,
            "bbox": {
              "x0": 213.2910614013672,
              "y0": 550.4030151367188,
              "x1": 253.39657592773438,
              "y1": 543.635009765625
            }
          },
          {
            "node_id": "#/texts/8140",
            "canonical_text": "If you select manual, you have to select the required heart phase that is to be used for the reconstruction. You have to select the Unit .",
            "semantic_order": 8198,
            "node_type": "paragraph",
            "page_no": 376,
            "bbox": {
              "x0": 222.80938720703125,
              "y0": 532.4930419921875,
              "x1": 537.84228515625,
              "y1": 513.635009765625
            }
          },
          {
            "node_id": "#/texts/8141",
            "canonical_text": "The reconstruction is performed based on the delay value of the determined phase.",
            "semantic_order": 8199,
            "node_type": "paragraph",
            "page_no": 376,
            "bbox": {
              "x0": 212.72044372558594,
              "y0": 502.4930419921875,
              "x1": 537.8364868164062,
              "y1": 493.70904541015625
            }
          },
          {
            "node_id": "#/texts/8142",
            "canonical_text": "The best phase is displayed on the Trigger parameter card. After the reconstruction is finished, the recon boxes will be set to the right phase.",
            "semantic_order": 8200,
            "node_type": "paragraph",
            "page_no": 376,
            "bbox": {
              "x0": 212.7208251953125,
              "y0": 484.5650329589844,
              "x1": 537.8309936523438,
              "y1": 463.70904541015625
            }
          }
        ]
      },

              "x1": 331.6439514160156,
              "y1": 204.12789916992188
            }
          },
          {
            "node_id": "#/texts/6526",
            "canonical_text": "The current table position is zeroed at the RT Laser position. This enables the functionality to move the patient table back to zero (external (RT) laser position) after the scan.",

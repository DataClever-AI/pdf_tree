              "y1": 722.25830078125
            }
          },
          {
            "node_id": "#/texts/6514",
            "canonical_text": "The marks on the patient are lined up with the external RT Laser again.",
            "semantic_order": 6557,
            "node_type": "paragraph",
            "page_no": 301,
            "bbox": {
              "x0": 212.72596740722656,

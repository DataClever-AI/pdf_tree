        "semantic_nodes": [
          {
            "node_id": "#/texts/5548",
            "canonical_text": "Levels of Event Surveillance",
            "semantic_order": 5620,
            "node_type": "heading",
            "page_no": 303,
            "bbox": {
              "x0": 72.37847900390625,
              "y0": 322.086181640625,
              "x1": 330.98553466796875,
              "y1": 308.1201477050781
            }
          },
          {
            "node_id": "#/texts/5549",
            "canonical_text": "The appearance of the Events windows and menus and the settings you can select for events depends on the event surveillance option purchased for your monitor: basic event surveillance, advanced event surveillance, or neonatal event review (NER).This table lists the differences between the options.",
            "semantic_order": 5621,
            "node_type": "paragraph",
            "page_no": 303,
            "bbox": {
              "x0": 137.53350830078125,
              "y0": 291.1275939941406,
              "x1": 550.369384765625,
              "y1": 255.9011993408203
            }
          },
          {
            "node_id": "#/texts/5550",
            "canonical_text": "To determine which level of event surveillance your monitor has, select Main Setup -> Event Surveill. -> Setup Events and select the trigger group to see the available event groups.",
            "semantic_order": 5622,
            "node_type": "paragraph",
            "page_no": 303,
            "bbox": {
              "x0": 137.53350830078125,
              "y0": 248.5869140625,
              "x1": 542.8964233398438,
              "y1": 213.24490356445312
            }
          },
          {
            "node_id": "#/texts/5551",
            "canonical_text": "if the only event group listed is NER, your monitor has the Neonatal Event Review option",
            "semantic_order": 5623,
            "node_type": "paragraph",
            "page_no": 303,
            "bbox": {
              "x0": 138.03750610351562,
              "y0": 206.1060028076172,
              "x1": 514.9265747070312,
              "y1": 195.7845001220703
            }
          },
          {
            "node_id": "#/texts/5552",
            "canonical_text": "if there is one event group and it is not NER, your monitor has the Basic Event Surveillance option",
            "semantic_order": 5624,
            "node_type": "paragraph",
            "page_no": 303,
            "bbox": {
              "x0": 138.03750610351562,
              "y0": 187.56610107421875,
              "x1": 549.7636108398438,
              "y1": 177.24459838867188
            }
          },
          {
            "node_id": "#/texts/5553",
            "canonical_text": "if you see six event groups, your monitor has the Advanced Event Surveillance option.",
            "semantic_order": 5625,
            "node_type": "paragraph",
            "page_no": 303,
            "bbox": {
              "x0": 138.03750610351562,
              "y0": 169.0861053466797,
              "x1": 499.04840087890625,

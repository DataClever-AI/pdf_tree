      "section": {
        "section_id": "sec_0560",
        "title": "Setting the Horizon",
        "hierarchy_level": 4,
        "hierarchy_path": "/Trends/Screen Trends/Changing the Screen Trend View/Setting the Horizon",
        "page_start": 294,
        "page_end": 294,
        "parent_section_id": "sec_0556",
        "child_sections": [],
        "node_count": 9,
        "confidence": 1.0,
        "structural_source": "toc",
        "flagged_for_review": false,
        "verification_score": 100.0,
        "verification_reason": "",
        "numbering_scheme": "arabic",
        "offset_applied": 0,
        "semantic_order_start": 5420,
        "semantic_order_end": 5428,
        "semantic_nodes": [
          {
            "node_id": "#/texts/5351",
            "canonical_text": "Setting the Horizon",
            "semantic_order": 5420,
            "node_type": "heading",
            "page_no": 294,
            "bbox": {
              "x0": 71.3759994506836,
              "y0": 721.4519653320312,
              "x1": 181.46640014648438,
              "y1": 710.4119873046875
            }
          },
          {
            "node_id": "#/texts/5352",
            "canonical_text": "The horizon is the reference value to which deviations in the measurements are compared.",
            "semantic_order": 5421,
            "node_type": "paragraph",
            "page_no": 294,
            "bbox": {
              "x0": 137.53350830078125,
              "y0": 704.6475219726562,
              "x1": 501.9002990722656,
              "y1": 694.4415283203125
            }
          },
          {
            "node_id": "#/texts/5353",
            "canonical_text": "1 To set the horizon, select the horizon trend",
            "semantic_order": 5422,
            "node_type": "paragraph",
            "page_no": 294,
            "bbox": {
              "x0": 138.55560302734375,
              "y0": 687.1275024414062,
              "x1": 328.27496337890625,
              "y1": 678.3599853515625
            }
          },
          {
            "node_id": "#/texts/5354",
            "canonical_text": "2 Select",
            "semantic_order": 5423,
            "node_type": "paragraph",
            "page_no": 294,
            "bbox": {
              "x0": 137.6492462158203,
              "y0": 669.66748046875,
              "x1": 177.79214477539062,
              "y1": 662.0025024414062
            }
          },
          {
            "node_id": "#/texts/5355",
            "canonical_text": "– Set High Horizon to select the upper horizon value. If the high and low horizon values are the same, the horizon is a baseline - if the values are different the horizon is a range.",
            "semantic_order": 5424,
            "node_type": "paragraph",
            "page_no": 294,
            "bbox": {
              "x0": 149.17919921875,
              "y0": 654.8475341796875,
              "x1": 553.1389770507812,
              "y1": 633.0064697265625
            }
          },
          {
            "node_id": "#/texts/5356",
            "canonical_text": "– Set Low Horizon to select the lower horizon value.",
            "semantic_order": 5425,
            "node_type": "paragraph",
            "page_no": 294,
            "bbox": {
              "x0": 149.17919921875,
              "y0": 630.7875366210938,
              "x1": 391.70819091796875,
              "y1": 623.0385131835938
            }
          },
          {
            "node_id": "#/texts/5357",
            "canonical_text": "– Auto Horizon to set the horizon for the selected horizon trend to the currently-measured value",
            "semantic_order": 5426,
            "node_type": "paragraph",
            "page_no": 294,
            "bbox": {
              "x0": 148.80020141601562,
              "y0": 616.627197265625,
              "x1": 540.8218994140625,
              "y1": 595.3782958984375
            }
          },
          {
            "node_id": "#/texts/5358",
            "canonical_text": "– Auto All to reset the horizon for all horizon screen trends to the currently-measured values",
            "semantic_order": 5427,
            "node_type": "paragraph",
            "page_no": 294,
            "bbox": {
              "x0": 148.80020141601562,
              "y0": 587.647216796875,
              "x1": 540.5604248046875,
              "y1": 577.5357055664062
            }
          },
          {
            "node_id": "#/texts/5359",
            "canonical_text": "– Set Horizon to set the horizon to a specific value from a pop-up list.",
            "semantic_order": 5428,
            "node_type": "paragraph",
            "page_no": 294,
            "bbox": {
              "x0": 148.80020141601562,
              "y0": 572.1669921875,
              "x1": 455.00323486328125,
              "y1": 561.9609985351562
            }
          }
        ]
      },

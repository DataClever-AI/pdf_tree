              "y1": 746.2191772460938
            }
          },
          {
            "node_id": "#/texts/7274",
            "canonical_text": "Battery compartment",
            "semantic_order": 7372,
            "node_type": "paragraph",
            "page_no": 382,
            "bbox": {
              "x0": 336.3494873046875,
              "y0": 487.3815002441406,
              "x1": 422.8149108886719,
              "y1": 477.7215270996094
            }
          },
          {
            "node_id": "#/texts/7275",
            "canonical_text": "The MP60/MP70/MP80/MP90 monitors cannot be powered by battery.",
            "semantic_order": 7373,
            "node_type": "paragraph",
            "page_no": 382,
            "bbox": {
              "x0": 137.53350830078125,
              "y0": 451.50750732421875,
              "x1": 437.76220703125,
              "y1": 441.301513671875
            }
          },
          {
            "node_id": "#/texts/7276",
            "canonical_text": "You can switch between battery-powered and mains-powered (AC) operation without interrupting monitoring.",
            "semantic_order": 7374,
            "node_type": "paragraph",
            "page_no": 382,
            "bbox": {
              "x0": 137.37600708007812,
              "y0": 433.9872131347656,
              "x1": 539.8661499023438,
              "y1": 411.1853942871094
            }
          },
          {
            "node_id": "#/texts/7277",
            "canonical_text": "When an X2 or MP5 is connected to a host monitor, no battery data from the X2 is visible on the host. Battery INOPs, however, are displayed.",
            "semantic_order": 7375,
            "node_type": "paragraph",
            "page_no": 382,
            "bbox": {
              "x0": 137.37600708007812,
              "y0": 403.9866027832031,
              "x1": 553.054443359375,
              "y1": 381.3003234863281
            }
          },
          {
            "node_id": "#/texts/7278",
            "canonical_text": "The batteries recharge automatically whenever the monitor is connected to mains power.",
            "semantic_order": 7376,
            "node_type": "paragraph",
            "page_no": 382,
            "bbox": {
              "x0": 137.53350830078125,
              "y0": 373.9859924316406,
              "x1": 496.42864990234375,
              "y1": 363.66448974609375
            }
          },
          {
            "node_id": "#/texts/7279",
            "canonical_text": "Battery operation may not be available in all geographies.",
            "semantic_order": 7377,
            "node_type": "paragraph",
            "page_no": 382,
            "bbox": {
              "x0": 137.8695068359375,
              "y0": 356.4656982421875,
              "x1": 371.7002868652344,
              "y1": 346.1441955566406
            }
          }
        ]

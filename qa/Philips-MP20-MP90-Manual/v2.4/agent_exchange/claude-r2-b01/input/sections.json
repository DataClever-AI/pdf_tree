              "y1": 746.2191772460938
            }
          },
          {
            "node_id": "#/texts/5942",
            "canonical_text": "WARNING",
            "semantic_order": 6020,
            "node_type": "heading",
            "page_no": 322,
            "bbox": {
              "x0": 76.5,
              "y0": 599.8623657226562,
              "x1": 127.3218994140625,
              "y1": 592.9003295898438
            }
          },
          {
            "node_id": "#/texts/5943",
            "canonical_text": "Sepsis Management Bundle - the recommendations to maintain patient status are listed and can be checked off as they are implemented. The Sepsis Management Bundle ends when 24 hours have passed since the Sepsis Resuscitation Bundle began.",
            "semantic_order": 6021,
            "node_type": "paragraph",
            "page_no": 322,
            "bbox": {
              "x0": 137.75401306152344,
              "y0": 721.6380004882812,
              "x1": 553.1150512695312,
              "y1": 686.3453979492188
            }
          },
          {
            "node_id": "#/texts/5944",
            "canonical_text": "Depending on the option your monitor has, it may be that only the Severe Sepsis Screening phase is implemented. If, at the end of this phase sepsis has been confirmed, and the patient is transferred for treatment in the resuscitation and management phases, you can transfer the current state, the settings and the log from the SSC Sepsis Protocol in the MMS to another monitor with the full version of the SSC Sepsis Protocol. The transfer of data and settings must be enabled in Configuration mode.",
            "semantic_order": 6022,
            "node_type": "paragraph",
            "page_no": 322,
            "bbox": {
              "x0": 137.79600524902344,
              "y0": 679.1466064453125,
              "x1": 551.8140869140625,
              "y1": 618.843994140625
            }
          },
          {
            "node_id": "#/texts/5945",
            "canonical_text": "Always consider the specific clinical context for your patient, before following SSC Sepsis Protocol treatment recommendations.",
            "semantic_order": 6023,
            "node_type": "paragraph",
            "page_no": 322,
            "bbox": {
              "x0": 137.176513671875,
              "y0": 600.4874877929688,
              "x1": 538.5379638671875,
              "y1": 580.2581787109375
            }
          },
          {
            "node_id": "#/texts/5946",
            "canonical_text": "The SSC Sepsis Protocol and this description are based on the SSC Guidelines for Management of Severe Sepsis and Septic Shock2 k2 from January 2008 and the SSC Bundle definitions from January 2005. To check the version of the Guidelines and Bundle definitions on the monitor,",
            "semantic_order": 6024,
            "node_type": "paragraph",
            "page_no": 322,
            "bbox": {
              "x0": 137.53350830078125,
              "y0": 551.47802734375,
              "x1": 553.1015625,
              "y1": 517.6798095703125
            }
          },
          {
            "node_id": "#/texts/5947",
            "canonical_text": "♦ Select Main Setup -> Revision -> ProtocolWatch -> SSC Sepsis",
            "semantic_order": 6025,
            "node_type": "paragraph",
            "page_no": 322,
            "bbox": {
              "x0": 137.79864501953125,
              "y0": 508.9875183105469,
              "x1": 479.54534912109375,
              "y1": 499.2960205078125
            }
          },
          {
